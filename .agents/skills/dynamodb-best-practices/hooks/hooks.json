{
  "description": "Route AWS and DynamoDB prompts to the DynamoDB best-practices skill.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/dynamodb-context.js"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
