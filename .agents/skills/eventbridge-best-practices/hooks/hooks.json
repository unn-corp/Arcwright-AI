{
  "description": "Route EventBridge work to the best-practices skill and add fast advisory review hints after event-routing edits.",
  "hooks": {
    "SessionStart": [{"matcher":"","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/eventbridge-context.js"],"timeout":3}]}],
    "UserPromptSubmit": [{"matcher":"","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/eventbridge-context.js"],"timeout":3}]}],
    "PostToolUse": [{"matcher":"Write|Edit","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/eventbridge-review.js"],"timeout":3}] }]
  }
}
