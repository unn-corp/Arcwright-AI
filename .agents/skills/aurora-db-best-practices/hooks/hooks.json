{
  "description": "Route Aurora database work to the best-practices skill and add fast advisory review hints after database-related edits.",
  "hooks": {
    "SessionStart": [{"matcher":"","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/aurora-context.js"],"timeout":3}]}],
    "UserPromptSubmit": [{"matcher":"","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/aurora-context.js"],"timeout":3}]}],
    "PostToolUse": [{"matcher":"Write|Edit","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/aurora-review.js"],"timeout":3}]}]
  }
}
