{
  "description": "Route S3 work to the best-practices skill and add fast advisory review hints after bucket/object-related edits.",
  "hooks": {
    "SessionStart": [{"matcher":"","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/s3-context.js"],"timeout":3}]}],
    "UserPromptSubmit": [{"matcher":"","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/s3-context.js"],"timeout":3}]}],
    "PostToolUse": [{"matcher":"Write|Edit","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/s3-review.js"],"timeout":3}]}]
  }
}
