{
  "description": "Route CloudFront/CDN work to the best-practices skill and add fast advisory review hints after delivery-related edits.",
  "hooks": {
    "SessionStart": [{"matcher":"","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/cloudfront-context.js"],"timeout":3}]}],
    "UserPromptSubmit": [{"matcher":"","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/cloudfront-context.js"],"timeout":3}]}],
    "PostToolUse": [{"matcher":"Write|Edit","hooks":[{"type":"command","command":"node","args":["${CLAUDE_PLUGIN_ROOT}/hooks/cloudfront-review.js"],"timeout":3}]}]
  }
}
